{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fields": {"type": "array", "items": {"$ref": "#/definitions/namedField"}},
    "x-mountainash": {"type": "object"}
  },
  "definitions": {
    "namedField": {
      "allOf": [
        {"$ref": "#/definitions/body"},
        {"required": ["name"], "properties": {"name": {"type": "string"}}}
      ]
    },
    "element": {
      "allOf": [{"$ref": "#/definitions/body"}, {"not": {"required": ["name"]}}]
    },
    "body": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "format": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "rdfType": {"type": "string"},
        "missingValues": {"type": "array"},
        "categories": {"type": "array"},
        "categoriesOrdered": {"type": "boolean"},
        "trueValues": {"type": "array", "items": {"type": "string"}},
        "falseValues": {"type": "array", "items": {"type": "string"}},
        "decimalChar": {"type": "string"},
        "groupChar": {"type": "string"},
        "bareNumber": {"type": "boolean"},
        "itemType": {"type": "string"},
        "delimiter": {"type": "string"},
        "constraints": {"$ref": "#/definitions/constraints"},
        "x-mountainash": {"$ref": "#/definitions/extension"}
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "pattern": {"type": "string"},
        "enum": {"type": "array"},
        "jsonSchema": {"type": ["object", "boolean"]}
      }
    },
    "extension": {
      "type": "object",
      "properties": {
        "fields": {"type": "array", "items": {"$ref": "#/definitions/namedField"}},
        "element": {"$ref": "#/definitions/element"},
        "dimensions": {
          "anyOf": [
            {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
            {"const": {"kind": "unknown"}}
          ]
        },
        "dtype": {"type": "object"},
        "rename_from": {"type": "string"},
        "custom_cast": {"type": "string"},
        "backend_type": {"type": ["string", "null"]},
        "rounding": {"type": ["string", "null"]},
        "severity": {"type": "string"},
        "enum_weights": {"type": "object"},
        "constraints": {
          "type": "object",
          "properties": {
            "notin": {"type": "array"},
            "str_contains": {"type": "string"},
            "str_startswith": {"type": "string"},
            "str_endswith": {"type": "string"}
          }
        }
      },
      "not": {"required": ["fields", "element"]},
      "dependencies": {"dimensions": ["element"]}
    }
  }
}
